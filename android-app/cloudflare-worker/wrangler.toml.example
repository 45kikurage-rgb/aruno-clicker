name = "aruno-clicker-config"
main = "src/index.js"
compatibility_date = "2026-09-22"
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "aruno-clicker-config"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[vars]
# Optional. Remove when no browser-based management page is used.
# Android apps are not subject to browser CORS.
ALLOWED_ADMIN_ORIGIN = "https://admin.example.com"
